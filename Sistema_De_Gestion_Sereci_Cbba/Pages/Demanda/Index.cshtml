@page
@model Sistema_De_Gestion_Sereci_Cbba.Pages.DemandaModel

@{
    ViewData["Title"] = "Demanda";
}

<style>
    .demand-page {
        max-width: 1500px;
        margin: 0 auto;
    }

    .demand-header {
        margin-bottom: 24px;
    }

        .demand-header h2 {
            font-size: 26px;
            font-weight: 700;
            margin-bottom: 5px;
            color: #1f2937;
        }

        .demand-header p {
            color: #64748b;
            margin: 0;
            font-size: 14px;
        }

    .demand-filter-card,
    .demand-card,
    .demand-table-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
    }

    .demand-filter-card {
        padding: 20px;
        margin-bottom: 20px;
    }

    .metric-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 20px;
        height: 100%;
    }

    .metric-label {
        font-size: 12px;
        font-weight: 600;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: .4px;
    }

    .metric-value {
        margin-top: 8px;
        font-size: 27px;
        font-weight: 700;
        color: #1e3a5f;
    }

    .metric-note {
        margin-top: 4px;
        color: #94a3b8;
        font-size: 12px;
    }

    .demand-card {
        padding: 20px;
        margin-bottom: 24px;
    }

    .section-title {
        font-size: 15px;
        font-weight: 700;
        color: #334155;
        margin-bottom: 18px;
    }

    .table-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 18px 20px;
        border-bottom: 1px solid #e5e7eb;
    }

        .table-header h5 {
            margin: 0;
            font-size: 15px;
            font-weight: 700;
        }

    .demand-table-card {
        overflow: hidden;
    }

        .demand-table-card .table {
            margin-bottom: 0;
        }

        .demand-table-card th {
            background: #f8fafc;
            color: #64748b;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: .4px;
        }

        .demand-table-card td {
            vertical-align: middle;
            font-size: 13px;
        }
</style>

<div class="demand-page">

    <div class="demand-header">
        <h2>Análisis de demanda</h2>
        <p>
            Comportamiento de usuarios por fecha,
            franja horaria y tipo de trámite.
        </p>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Mensaje))
    {
        <div class="alert alert-success alert-dismissible fade show">
            @Model.Mensaje

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <!-- FILTROS -->
    <form method="get"
          class="demand-filter-card">

        <div class="row g-3 align-items-end">

            <div class="col-md-4">
                <label class="form-label">
                    Fecha
                </label>

                <input asp-for="FechaFiltro"
                       type="date"
                       class="form-control" />
            </div>

            <div class="col-md-4">
                <label class="form-label">
                    Tipo de trámite
                </label>

                <select asp-for="TramiteFiltroId"
                        class="form-select">

                    <option value="">
                        Todos los trámites
                    </option>

                    @foreach (var tramite in Model.Tramites)
                    {
                        <option value="@tramite.Id">
                            @tramite.Nombre
                        </option>
                    }

                </select>
            </div>

            <div class="col-md-4 d-flex gap-2">

                <button type="submit"
                        class="btn btn-primary">
                    Aplicar filtros
                </button>

                <a asp-page="/Demanda/Index"
                   class="btn btn-outline-secondary">
                    Limpiar
                </a>

            </div>

        </div>

    </form>

    <!-- INDICADORES -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="metric-card">

                <div class="metric-label">
                    Demanda total
                </div>

                <div class="metric-value">
                    @Model.DemandaTotal
                </div>

                <div class="metric-note">
                    usuarios registrados
                </div>

            </div>
        </div>

        <div class="col-md-4">
            <div class="metric-card">

                <div class="metric-label">
                    Promedio
                </div>

                <div class="metric-value">
                    @Model.PromedioDemanda.ToString("0.0")
                </div>

                <div class="metric-note">
                    usuarios por registro
                </div>

            </div>
        </div>

        <div class="col-md-4">
            <div class="metric-card">

                <div class="metric-label">
                    Mayor demanda
                </div>

                <div class="metric-value"
                     style="font-size: 22px;">
                    @Model.FranjaMayorDemanda
                </div>

                <div class="metric-note">
                    franja de mayor afluencia
                </div>

            </div>
        </div>

    </div>

    <!-- GRÁFICO -->
    <div class="demand-card">

        <div class="section-title">
            Demanda por franja horaria
        </div>

        @if (Model.Registros.Count == 0)
        {
            <div class="text-center text-muted py-5">
                No existen datos para generar el gráfico.
            </div>
        }
        else
        {
            <div style="height: 300px;">
                <canvas id="graficoDemanda"></canvas>
            </div>
        }

    </div>

    <!-- TABLA -->
    <div class="demand-table-card">

        <div class="table-header">

            <h5>Registros de demanda</h5>

            <button type="button"
                    class="btn btn-primary"
                    data-bs-toggle="modal"
                    data-bs-target="#modalDemanda">

                + Registrar demanda

            </button>

        </div>

        <div class="table-responsive">

            <table class="table table-hover">

                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Horario</th>
                        <th>Trámite</th>
                        <th>Usuarios</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Registros.Count == 0)
                    {
                        <tr>
                            <td colspan="4"
                                class="text-center text-muted py-4">

                                No existen registros para
                                los filtros seleccionados.

                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var registro in Model.Registros)
                        {
                            <tr>

                                <td>
                                    @registro.Fecha.ToString("dd/MM/yyyy")
                                </td>

                                <td>
                                    @registro.FranjaHoraria
                                </td>

                                <td>
                                    @registro.Tramite.Nombre
                                </td>

                                <td>
                                    <strong>
                                        @registro.CantidadUsuarios
                                    </strong>
                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

    <div class="modal fade"
         id="modalDemanda"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog">

            <div class="modal-content">

                <form method="post"
                      asp-page-handler="Guardar">

                    <div class="modal-header">

                        <h5 class="modal-title">
                            Registrar demanda
                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal">
                        </button>

                    </div>

                    <div class="modal-body">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">

                            <label asp-for="Formulario.Fecha"
                                   class="form-label">
                                Fecha
                            </label>

                            <input asp-for="Formulario.Fecha"
                                   type="date"
                                   class="form-control" />

                        </div>

                        <div class="mb-3">

                            <label asp-for="Formulario.TramiteId"
                                   class="form-label">
                                Tipo de trámite
                            </label>

                            <select asp-for="Formulario.TramiteId"
                                    class="form-select">

                                <option value="">
                                    Seleccione un trámite
                                </option>

                                @foreach (var tramite in Model.Tramites)
                                {
                                    <option value="@tramite.Id">
                                        @tramite.Nombre
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="Formulario.TramiteId"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Formulario.FranjaHoraria"
                                   class="form-label">
                                Franja horaria
                            </label>

                            <select asp-for="Formulario.FranjaHoraria"
                                    class="form-select">

                                <option value="">
                                    Seleccione una franja
                                </option>

                                <option value="08:00-09:00">
                                    08:00 - 09:00
                                </option>

                                <option value="09:00-10:00">
                                    09:00 - 10:00
                                </option>

                                <option value="10:00-11:00">
                                    10:00 - 11:00
                                </option>

                                <option value="11:00-12:00">
                                    11:00 - 12:00
                                </option>

                            </select>

                            <span asp-validation-for="Formulario.FranjaHoraria"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Formulario.CantidadUsuarios"
                                   class="form-label">
                                Cantidad de usuarios
                            </label>

                            <input asp-for="Formulario.CantidadUsuarios"
                                   type="number"
                                   min="0"
                                   class="form-control" />

                            <span asp-validation-for="Formulario.CantidadUsuarios"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-outline-secondary"
                                data-bs-dismiss="modal">
                            Cancelar
                        </button>

                        <button type="submit"
                                class="btn btn-primary">
                            Guardar
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>
</div>

@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    @if (Model.Registros.Count > 0)
    {
        <script>

            const franjas = @Html.Raw(
                        System.Text.Json.JsonSerializer.Serialize(
                                Model.FranjasGrafico
                        )
                );

            const usuarios = @Html.Raw(
                        System.Text.Json.JsonSerializer.Serialize(
                                Model.UsuariosGrafico
                        )
                );

            const canvas = document.getElementById('graficoDemanda');

            new Chart(canvas, {
                type: 'bar',

                data: {
                    labels: franjas,

                    datasets: [{
                        label: 'Cantidad de usuarios',
                        data: usuarios,
                        borderWidth: 1,
                        borderRadius: 5
                    }]
                },

                options: {
                    responsive: true,
                    maintainAspectRatio: false,

                    plugins: {
                        legend: {
                            display: false
                        }
                    },

                    scales: {
                        y: {
                            beginAtZero: true,

                            ticks: {
                                precision: 0
                            },

                            title: {
                                display: true,
                                text: 'Usuarios'
                            }
                        },

                        x: {
                            title: {
                                display: true,
                                text: 'Franja horaria'
                            }
                        }
                    }
                }
            });

        </script>
    }
    @if (!ViewData.ModelState.IsValid)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {

                const modalElement =
                    document.getElementById('modalDemanda');

                if (modalElement) {
                    const modal =
                        new bootstrap.Modal(modalElement);

                    modal.show();
                }
            });
        </script>
    }
    @if (!ViewData.ModelState.IsValid)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {

                const modalElement =
                    document.getElementById('modalDemanda');

                if (modalElement) {
                    const modal =
                        new bootstrap.Modal(modalElement);

                    modal.show();
                }
            });
        </script>
    }
}