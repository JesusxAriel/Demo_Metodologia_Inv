@page
@model Sistema_De_Gestion_Sereci_Cbba.Pages.SimulacionModel
@{
    ViewData["Title"] = "Simulación";
    var f = Model.Formulario;
    var esDinamica = f.MetodoAsignacion != SimulacionModel.MetodoConvencional;
    var maxPuntos = Model.PuntosRegistrados > 0 ? Model.PuntosRegistrados : 99;
}

<section class="simulation-page">
    <div class="page-heading">
        <div>
            <span class="eyebrow">MÓDULO DE ANÁLISIS</span>
            <h1>Simulación de atención</h1>
            <p>Define las variables para evaluar el comportamiento del sistema.</p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Mensaje))
    {
        <div class="feedback-message feedback-success" role="status">@Model.Mensaje</div>
    }
    <div asp-validation-summary="ModelOnly" class="validation-message"></div>

    <form method="post" asp-page-handler="Ejecutar" id="simulation-form" novalidate>
        @Html.AntiForgeryToken()
        <div class="simulation-grid">
            <section class="panel simulation-config">
                <div class="panel-header">
                    <div>
                        <h2>Configuración del escenario</h2>
                        <p>Variables de entrada para el modelo de simulación.</p>
                    </div>
                    <span class="panel-badge">01</span>
                </div>

                <div class="simulation-fields">
                    <div class="simulation-field">
                        <label class="field-label" for="sim-nombre">Nombre del escenario</label>
                        <input class="field-control" id="sim-nombre" name="Formulario.Nombre"
                               type="text" maxlength="100" value="@f.Nombre" />
                        <span asp-validation-for="Formulario.Nombre" class="validation-message"></span>
                    </div>

                    <div class="simulation-field">
                        <label class="field-label" for="sim-usuarios">Cantidad estimada de usuarios</label>
                        <input class="field-control" id="sim-usuarios" name="Formulario.CantidadUsuarios"
                               type="number" min="1" step="1" value="@f.CantidadUsuarios" />
                        <span asp-validation-for="Formulario.CantidadUsuarios" class="validation-message"></span>
                    </div>

                    <div class="simulation-field">
                        <label class="field-label" for="sim-puntos">Cantidad de puntos de atención</label>
                        <input class="field-control" id="sim-puntos" name="Formulario.PuntosActivos"
                               type="number" min="1" max="@maxPuntos" step="1" value="@f.PuntosActivos" />
                        @if (Model.PuntosRegistrados > 0)
                        {
                            <span class="form-help">Hay @Model.PuntosRegistrados ventanillas registradas.</span>
                        }
                        <span asp-validation-for="Formulario.PuntosActivos" class="validation-message"></span>
                    </div>

                    <div class="simulation-field">
                        <label class="field-label" for="sim-inicio">Hora inicial</label>
                        <input class="field-control" id="sim-inicio" name="Formulario.HoraInicio"
                               type="time" value="@f.HoraInicio.ToString("HH:mm")" />
                    </div>

                    <div class="simulation-field">
                        <label class="field-label" for="sim-fin">Hora final</label>
                        <input class="field-control" id="sim-fin" name="Formulario.HoraFin"
                               type="time" value="@f.HoraFin.ToString("HH:mm")" />
                        <span asp-validation-for="Formulario.HoraFin" class="validation-message"></span>
                    </div>

                    <div class="simulation-field">
                        <label class="field-label" for="sim-metodo">Método de asignación</label>
                        <select class="field-control" id="sim-metodo">
                            <option value="Convencional" selected="@(!esDinamica)">Distribución convencional</option>
                            <option value="Dinamica" selected="@esDinamica">Asignación dinámica</option>
                        </select>
                        <span asp-validation-for="Formulario.MetodoAsignacion" class="validation-message"></span>
                    </div>
                </div>

                <div class="method-options" role="radiogroup" aria-label="Método de asignación">
                    <label class="method-card @(esDinamica ? "" : "selected")">
                        <input type="radio" name="Formulario.MetodoAsignacion" value="Convencional"
                               checked="@(!esDinamica)" />
                        <span class="method-radio" aria-hidden="true"></span>
                        <span class="method-text">
                            <strong>Distribución convencional</strong>
                            <small>Asignación secuencial por orden de llegada.</small>
                        </span>
                    </label>
                    <label class="method-card @(esDinamica ? "selected" : "")">
                        <input type="radio" name="Formulario.MetodoAsignacion" value="Dinamica"
                               checked="@esDinamica" />
                        <span class="method-radio" aria-hidden="true"></span>
                        <span class="method-text">
                            <strong>Asignación dinámica</strong>
                            <small>Optimización según carga y capacidad.</small>
                        </span>
                        <span class="method-tag"><span class="chip-dot"></span>Propuesta</span>
                    </label>
                </div>
            </section>

            <aside class="panel simulation-summary">
                <div class="panel-header">
                    <div>
                        <h2>Resumen de configuración</h2>
                        <p>Revise las variables antes de ejecutar.</p>
                    </div>
                    <span class="panel-badge">02</span>
                </div>

                <div class="scenario-card">
                    <span class="scenario-icon" aria-hidden="true">▶</span>
                    <div>
                        <span class="scenario-eyebrow">ESCENARIO</span>
                        <strong id="sum-nombre">@f.Nombre</strong>
                    </div>
                </div>

                <dl class="summary-list">
                    <div><dt>Usuarios estimados</dt><dd id="sum-usuarios">@f.CantidadUsuarios</dd></div>
                    <div><dt>Puntos de atención</dt><dd id="sum-puntos">@f.PuntosActivos activos</dd></div>
                    <div><dt>Periodo simulado</dt><dd id="sum-periodo">@f.HoraInicio.ToString("HH:mm")-@f.HoraFin.ToString("HH:mm")</dd></div>
                    <div><dt>Duración</dt><dd id="sum-duracion">@SimulacionModel.FormatearDuracion(f.HoraInicio, f.HoraFin)</dd></div>
                    <div>
                        <dt>Método</dt>
                        <dd><span class="method-pill" id="sum-metodo"><span class="chip-dot"></span><span>@(esDinamica ? "Asignación dinámica" : "Distribución convencional")</span></span></dd>
                    </div>
                </dl>

                <div class="demo-notice" role="note">
                    <span class="demo-notice-icon" aria-hidden="true">i</span>
                    <p>La ejecución utiliza datos de demostración y no representa resultados reales del SERECI.</p>
                </div>

                <button type="submit" class="primary-button run-button" id="run-button">
                    <span class="run-icon" aria-hidden="true">▶</span>
                    <span id="run-label">Ejecutar simulación</span>
                    <span id="run-spinner" class="spinner d-none" aria-hidden="true"></span>
                </button>
            </aside>
        </div>
    </form>
</section>

@section Scripts {
    <script>
        (() => {
            const $ = (id) => document.getElementById(id);
            const form = $("simulation-form");
            const nombre = $("sim-nombre");
            const usuarios = $("sim-usuarios");
            const puntos = $("sim-puntos");
            const inicio = $("sim-inicio");
            const fin = $("sim-fin");
            const metodoSelect = $("sim-metodo");
            const radios = form.querySelectorAll('input[name="Formulario.MetodoAsignacion"]');
            const etiquetas = { Convencional: "Distribución convencional", Dinamica: "Asignación dinámica" };

            const aMinutos = (valor) => {
                const [h, m] = (valor || "").split(":").map(Number);
                return Number.isNaN(h) || Number.isNaN(m) ? null : h * 60 + m;
            };

            const duracion = () => {
                const a = aMinutos(inicio.value);
                const b = aMinutos(fin.value);
                if (a === null || b === null || b <= a) {
                    return "—";
                }
                const total = b - a;
                const horas = Math.floor(total / 60);
                const resto = total % 60;
                const textoHoras = horas === 1 ? "1 hora" : `${horas} horas`;
                if (resto === 0) {
                    return textoHoras;
                }
                return horas === 0 ? `${resto} min` : `${horas} h ${resto} min`;
            };

            const metodoActual = () =>
                [...radios].find((radio) => radio.checked)?.value ?? "Dinamica";

            const actualizar = () => {
                const metodo = metodoActual();
                $("sum-nombre").textContent = nombre.value.trim() || "Sin nombre";
                $("sum-usuarios").textContent = usuarios.value || "0";
                $("sum-puntos").textContent = `${puntos.value || 0} activos`;
                $("sum-periodo").textContent = `${inicio.value || "--:--"}-${fin.value || "--:--"}`;
                $("sum-duracion").textContent = duracion();
                $("sum-metodo").lastElementChild.textContent = etiquetas[metodo];
                metodoSelect.value = metodo;
                radios.forEach((radio) =>
                    radio.closest(".method-card").classList.toggle("selected", radio.checked));
            };

            [nombre, usuarios, puntos, inicio, fin].forEach((campo) =>
                campo.addEventListener("input", actualizar));
            radios.forEach((radio) => radio.addEventListener("change", actualizar));
            metodoSelect.addEventListener("change", () => {
                radios.forEach((radio) => { radio.checked = radio.value === metodoSelect.value; });
                actualizar();
            });

            form.addEventListener("submit", () => {
                $("run-button").disabled = true;
                $("run-label").textContent = "Ejecutando…";
                $("run-spinner").classList.remove("d-none");
            });

            actualizar();
        })();
    </script>
}
